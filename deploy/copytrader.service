[Unit]
Description=Ebenezer — Hyperliquid Copy Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ebenezer
EnvironmentFile=/home/ubuntu/ebenezer/.env
ExecStart=/home/ubuntu/ebenezer/.venv/bin/python main.py
Restart=always
RestartSec=10
MemoryMax=300M
CPUQuota=50%
StandardOutput=append:/var/log/copytrader/stdout.log
StandardError=append:/var/log/copytrader/stderr.log

[Install]
WantedBy=multi-user.target
